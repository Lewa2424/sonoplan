# Copy to infra/.env for local compose. No production secrets.
# Default values are for local development only.

POSTGRES_USER=sonoplan
POSTGRES_PASSWORD=sonoplan
POSTGRES_DB=sonoplan
POSTGRES_PORT=5432

RABBITMQ_USER=sonoplan
RABBITMQ_PASSWORD=sonoplan
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

MINIO_ROOT_USER=sonoplan
MINIO_ROOT_PASSWORD=sonoplan_dev_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- services/api (host against compose) ---
# Target Postgres for prod/staging: Neon (hosted). Local Docker Postgres is optional.
# Local compose default (no SSL):
DATABASE_URL=postgresql+psycopg://sonoplan:sonoplan@localhost:5432/sonoplan
# Neon example (SQLAlchemy + psycopg; sslmode=require required by Neon):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# After postgres is up: cd services/api && alembic upgrade head
#
# Pytest uses SQLite in-memory via fixture override only — do NOT set
# sqlite:// here for normal API runs; that is not the prod path.
# Do not commit real Neon credentials.

CELERY_BROKER_URL=amqp://sonoplan:sonoplan@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=sonoplan
S3_SECRET_KEY=sonoplan_dev_minio
S3_BUCKET=sonoplan

# Public client vars (Vite)
VITE_API_BASE_URL=http://localhost:8000
